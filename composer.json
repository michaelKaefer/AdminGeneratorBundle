{
    "name": "michaelkaefer/admin-generator-bundle",
    "description": "Autogenerate an admin web interface for entities",
    "license": "MIT",
    "type": "symfony-bundle",
    "authors": [
        {
            "name": "Project Contributors",
            "homepage": "https://github.com/michaelKaefer/AdminGeneratorBundle/graphs/contributors"
        }
    ],
    "require": {
        "php": ">=8.4",
        "doctrine/persistence": "^4.1",
        "michaelkaefer/table-bundle": "^0.1",
        "twig/string-extra": "^3.23",
        "knplabs/knp-menu-bundle": "^3.7",
        "league/flysystem-bundle": "^3.7",
        "knplabs/knp-paginator-bundle": "^6.11"
    },
    "autoload": {
        "psr-4": {
            "MichaelKaefer\\AdminGeneratorBundle\\": "AdminGeneratorBundle"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "MichaelKaefer\\AdminGeneratorBundle\\Tests\\": "tests"
        }
    }
}
