{%- block form_cell -%}
    {{ form(value) }}
{%- endblock form_cell -%}

{%- block link_cell -%}
    <a href="{{ value.target }}"{% with { attr: link_attr } %}{{ block('attributes') }}{% endwith %}>
        {{- value.label -}}
    </a>
{%- endblock link_cell -%}

{%- block menu_link_cell -%}
    {{ block('link_cell') }}
{%- endblock menu_link_cell -%}

{%- block preview_cell -%}
    <img src="{{ value }}"{% with { attr: preview_attr } %}{{ block('attributes') }}{% endwith %}>
{%- endblock preview_cell -%}
