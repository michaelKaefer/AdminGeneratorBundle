{% extends '@MichaelKaeferAdminUi/base.html.twig' %}

{% block title %}{{ object_name_singular|trans }}{% endblock %}

{% block object_menu %}
    {{ knp_menu_render(knp_menu_get('admin_generator_object_menu', [], {
        object: object,
        current_route: app.request.attributes.get('_route'),
    })) }}
{% endblock %}

{% block section %}
    {% macro renderTable(data) %}
        <table border="1" cellspacing="0" cellpadding="5">
            {% for key, value in data %}
                <tr>
                    <td><strong>{{ key }}</strong></td>
                    <td>
                        {% if value is iterable %}
                            {{ _self.renderTable(value) }}
                        {% else %}
                            {{ value }}
                        {% endif %}
                    </td>
                </tr>
            {% endfor %}
        </table>
    {% endmacro %}
    {{ _self.renderTable(detail) }}
{% endblock %}
